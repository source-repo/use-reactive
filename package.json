{
  "name": "@diginet/use-reactive",
  "version": "7.0.0",
  "description": "A small object-shaped reactive state hook for React.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.esm.js",
    "require": "./dist/index.cjs.js",
    "default": "./dist/index.esm.js"
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-repo/use-reactive.git"
  },
  "keywords": [
    "react",
    "react-hook",
    "useReactive",
    "reactivity",
    "proxy-state",
    "state-management",
    "react-custom-hook",
    "frontend",
    "javascript",
    "typescript",
    "useState",
    "useEffect",
    "react-proxy",
    "reactive-state",
    "hooks"
  ],
  "author": "anderswestberg",
  "license": "MIT",
  "dependencies": {
    "valtio": "^2.3.2"
  }
}
